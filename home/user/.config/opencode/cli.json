{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "keybinds": {
    "leader": "ctrl+x",
    "app.exit": "ctrl+d,<leader>q",
    "prompt.editor": "ctrl+g",
    "session.interrupt": "escape,ctrl+c",
    "session.line.up": "shift+up",
    "session.line.down": "shift+down",
    "session.first": "shift+home",
    "session.last": "shift+end",
    "input.line.home": "home",
    "input.line.end": "end",
    "input.buffer.home": "ctrl+home",
    "input.buffer.end": "ctrl+end"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show"
  },
  "animations": true,
  "mouse": false
}
