background-opacity = 0.95
font-family = Source Code Pro
font-size = 14
keybind = clear
window-decoration = false

# Clipboard
keybind = shift+ctrl+c=copy_to_clipboard
keybind = shift+ctrl+v=paste_from_clipboard

# Font size
keybind = shift+ctrl+equal=increase_font_size:1
keybind = shift+ctrl+minus=decrease_font_size:1
keybind = shift+ctrl+zero=reset_font_size

# Quick terminal (dropdown)
quick-terminal-position = top
quick-terminal-size = 40%,100%
quick-terminal-animation-duration = 0
keybind = global:ctrl+escape=toggle_quick_terminal
